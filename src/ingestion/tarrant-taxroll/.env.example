# Postgres connection string (Railway provides this automatically
# if you add their Postgres plugin — copy it from the Variables tab)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Current download link for the Tarrant County tax roll zip.
# Get this from:
# https://www.tarrantcountytx.gov/en/tax/property-tax/tarrant-county-tax-roll.html
# NOTE: verify this link is still current before each production run —
# the county can change it between refreshes.
TARRANT_TAXROLL_URL=https://www.tarrantcountytx.gov/PATH/TO/CURRENT/taxroll.zip
